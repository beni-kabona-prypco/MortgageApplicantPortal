{
  "name": "instamortgage-buyer",
  "version": "0.0.0",
  "sideEffects": false,
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  },
  "engines": {
    "node": ">=20 <21",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm run config:local",
    "ng": "ng",
    "config:local": "cp configs/local.json public/config.json",
    "config:development": "cp configs/development.json public/config.json",
    "config:staging": "cp configs/staging.json public/config.json",
    "config:production": "cp configs/production.json public/config.json",
    "config:e2e": "cp configs/e2e.json public/config.json",
    "start": "pnpm run config:local && ng serve",
    "start:e2e": "pnpm run config:e2e && ng serve --port 4202",
    "build": "ng build",
    "e2e": "playwright test --config e2e/playwright.config.ts --pass-with-no-tests",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --watch=false --code-coverage --browsers=ChromeHeadlessCI",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json,md}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,html,scss,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json,md}\"",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "code-quality": "pnpm run format:check && pnpm run lint && pnpm run type-check",
    "sanitize": "pnpm run format:check && pnpm run lint && pnpm run type-check"
  },
  "private": true,
  "dependencies": {
    "@amplitude/analytics-browser": "^2.47.0",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/localize": "^19.2.25",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@datadog/browser-logs": "^7.14.0",
    "@datadog/browser-rum": "^7.14.0",
    "@datadog/browser-rum-angular": "^7.14.0",
    "@ngrx/signals": "^19.2.1",
    "@prypco/web-themes": "1.4.0",
    "@prypco/web-tokens": "1.0.1",
    "@prypco/web-ui": "^2.5.3",
    "angularx-qrcode": "^22.0.1",
    "ng2-pdf-viewer": "^10.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.17",
    "@angular/cli": "^19.2.17",
    "@angular/compiler-cli": "^19.2.0",
    "@commitlint/cli": "^19.8.1",
    "@datadog/datadog-ci": "^5.24.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^26.1.1",
    "angular-eslint": "^19.8.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-sonarjs": "^3.0.7",
    "husky": "^9.1.7",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "msw": "^2.15.0",
    "playwright-msw": "^3.0.1",
    "prettier": "^3.9.4",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.63.0"
  }
}
